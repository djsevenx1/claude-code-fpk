#!/bin/bash
# Claude Code 沙箱 - install_init
# 安装前预检：验证 nodejs_v22 运行时可用、目标架构支持、ttyd 静态二进制可下载。
set -u
export PATH="/var/apps/nodejs_v22/target/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# UI 错误文件：只在 die() 时写，**绝不在 log 里写**
# （fnOS 商店会把 TRIM_TEMP_LOGFILE 的任何内容当作用户可见错误，
#  导致"安装中 100%"卡住不消失。）
TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE:-/tmp/claude-code-sandbox-install.err}"
mkdir -p "$(dirname "$TRIM_TEMP_LOGFILE")" 2>/dev/null || true

# 日志走 NAS 应用日志目录
LOG_FILE="${TRIM_PKGVAR:-/var/apps/claude-code-sandbox/var}/info.log"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true

die() { echo "[$(date '+%H:%M:%S')] FATAL: $*" >>"$LOG_FILE"; echo "$*" > "$TRIM_TEMP_LOGFILE"; exit 1; }
log() { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG_FILE" >&2; }

log "install_init: TRIM_APPNAME=${TRIM_APPNAME:-?} TRIM_APPVER=${TRIM_APPVER:-?} TRIM_SYS_ARCH=${TRIM_SYS_ARCH:-$(uname -m)}"

# 0. 幂等：检测是否重装（v1.1.x 残留）。残留会让 fnOS 商店进度回滚
OLD_INSTALLED=""
[ -x /var/apps/claude-code-sandbox/cmd/main ] && OLD_INSTALLED="1"
if [ -n "$OLD_INSTALLED" ]; then
    log "检测到旧版本残留，先执行 uninstall_init 清理"
    if [ -x /var/apps/claude-code-sandbox/cmd/uninstall_init ]; then
        bash /var/apps/claude-code-sandbox/cmd/uninstall_init || true
    fi
    # 清理可能冲突的 ttyd 旧二进制
    rm -f /var/apps/claude-code-sandbox/target/bin/ttyd 2>/dev/null || true
    # 清理 node_modules（强制 install_callback 重新装，避免版本不一致）
    rm -rf /var/apps/claude-code-sandbox/target/node_modules 2>/dev/null || true
    log "旧残留清理完成"
fi

# 1. nodejs_v22 运行时
# 关键：manifest 里有 install_dep_apps=nodejs_v22，fnOS 应用商店会**自己弹窗**问用户
# 要不要装。我们这里不挡路（之前 v1.1.x 直接 die 把安装流程打回 0% 进度）。
# 只在用户已经"忽略"或"拒绝"依赖安装时才报错，且报错信息要清晰指引。
NODEJS_PATH="/var/apps/nodejs_v22/target/bin"
if ! command -v node >/dev/null 2>&1 && [ ! -x "$NODEJS_PATH/node" ]; then
    # node 找不到，提示用户走应用商店
    die "未检测到 nodejs_v22 运行时。

请回飞牛应用中心 → 我的应用 → 找到 'nodejs_v22' → 手动点安装。
装好后再重新点 Claude Code 的'安装'按钮。

（manifest 已声明 install_dep_apps=nodejs_v22，理论上 fnOS 商店会
  在第一次安装时自动弹窗。如果被跳过，请手动从应用商店装。）"
fi
if [ ! -x "$NODEJS_PATH/node" ]; then
    # 备用：直接 /var/apps 下找 nodejs_v22
    FOUND_NODE=$(find /var/apps -maxdepth 3 -name node -type f -executable 2>/dev/null | grep nodejs | head -1)
    if [ -z "$FOUND_NODE" ]; then
        die "nodejs_v22 装在非标准路径，且 /var/apps 下找不到 node。请确认应用商店的 nodejs_v22 已装好。"
    else
        log "nodejs_v22 装在非标准路径: $FOUND_NODE（继续）"
    fi
fi
log "node=$(node -v)  npm=$(npm -v)"

# 2. 架构
ARCH="${TRIM_SYS_ARCH:-$(uname -m)}"
# 规范化：fnOS 0.9.x 早期版本会把 x86_64 上报为 "x86"，某些容器/32-bit 兼容层
# 会报 "i386/i686"。这里把常见别名都归一化到 x86_64 / aarch64 再判定。
case "$ARCH" in
    x86_64|amd64|x86)            NORM_ARCH="x86_64"  ;;
    aarch64|arm64)                NORM_ARCH="aarch64" ;;
    i386|i686|i486|i586)          NORM_ARCH="i386"    ;;
    *)                            NORM_ARCH="$ARCH"   ;;
esac
case "$NORM_ARCH" in
    x86_64)  log "架构 OK: x86_64 (raw=$ARCH)" ;;
    aarch64) log "架构 OK: aarch64 (但本包仅 platform=x86，不保证能装)" ;;
    *) die "不支持的 CPU 架构: $ARCH（仅支持 x86_64）" ;;
esac

# 3. 网络可达性（不阻塞，给 install_callback 用）
if command -v curl >/dev/null 2>&1; then
    if curl -fsSI --max-time 10 https://github.com >/dev/null 2>&1; then
        log "github.com 可达"
    else
        log "WARN: github.com 暂不可达，install_callback 阶段下载 ttyd 可能失败"
    fi
    if curl -fsSI --max-time 10 https://registry.npmmirror.com >/dev/null 2>&1; then
        log "registry.npmmirror.com 可达"
    else
        log "WARN: npmmirror 暂不可达，install_callback 装 claude-code 可能失败"
    fi
fi

log "install_init OK"
# 关键：成功路径下确保 TRIM_TEMP_LOGFILE 不存在/为空，商店才会切到"完成"
: > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
exit 0
