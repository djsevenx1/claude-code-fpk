#!/bin/bash
# Claude Code 沙箱 - install_init
# 安装前预检：只验证 nodejs_v22 运行时 + 预构建资源完整性。
#
# 关键设计（v1.2.6，照 OpenClaw 写法改造）：
#   - 用 cmd/lib/log.sh 统一日志到 ${TRIM_PKGVAR}/info.log
#   - 失败时把"可执行诊断"（node 版本、python 探测、关键路径、最近日志）写到
#     TRIM_TEMP_LOGFILE，fnOS 展示给用户（学 OpenClaw install_callback）
#   - install_init 只做最少预检，详细初始化放 install_callback

# 引入共享日志
_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/lib"
[ -f "${_LIB_DIR}/log.sh" ] && source "${_LIB_DIR}/log.sh"

# 引入 fnOS 应用商店的 Node.js v22（install_init 时系统尚未自动加 PATH）
export PATH="/var/apps/nodejs_v22/target/bin:${PATH}"

log_msg "=== install_init 开始 ==="
log_msg "TRIM_APPNAME=${TRIM_APPNAME:-?}  TRIM_APPDEST=${TRIM_APPDEST:-?}"

# 1. nodejs_v22 运行时检测
if ! command -v node >/dev/null 2>&1; then
    diag_to_user "安装预检失败" \
        "未检测到 nodejs_v22 运行时。请到 fnOS 应用中心搜索 'nodejs_v22' 安装后再重装 Claude Code。"
fi
log_msg "node 版本: $(node --version 2>/dev/null || echo '<failed>')"

# 2. 预构建资源完整性（ttyd + claude 都在 FPK 里，不下载）
APP_DEST="${TRIM_APPDEST:-/var/apps/${TRIM_APPNAME:-claude-code-sandbox}/target}"
if [ ! -x "${APP_DEST}/bin/ttyd" ]; then
    diag_to_user "安装预检失败" \
        "FPK 损坏：缺少 ${APP_DEST}/bin/ttyd。请重新下载安装包再装。"
fi
if [ ! -x "${APP_DEST}/node_modules/.bin/claude" ]; then
    diag_to_user "安装预检失败" \
        "FPK 损坏：缺少 ${APP_DEST}/node_modules/.bin/claude。请重新下载安装包再装。"
fi

log_msg "=== install_init 完成 ==="
exit 0
