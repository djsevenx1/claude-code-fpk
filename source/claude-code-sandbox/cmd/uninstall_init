#!/bin/bash
# Claude Code 沙箱 - uninstall_init
# 卸载前：停服务 + 安全删除 .env（API Key）
#
# 关键设计（v1.2.6）：用 cmd/lib/log.sh 统一日志 + pkill 兜底清理（学 OpenClaw）

_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/lib"
[ -f "${_LIB_DIR}/log.sh" ] && source "${_LIB_DIR}/log.sh"

log_msg "=== uninstall_init 开始 ==="

# 1. pkill 兜底清理 ttyd 残留（学 OpenClaw uninstall_init）
APP_DEST="${TRIM_APPDEST:-/var/apps/${TRIM_APPNAME:-claude-code-sandbox}/target}"
BIN_DIR="${APP_DEST}/bin"
pkill -f "${BIN_DIR}/ttyd" 2>/dev/null && log_msg "pkill 清理了残留 ttyd 进程" || true
pkill -f "claude-code-sandbox" 2>/dev/null && log_msg "pkill 清理了残留 claude 进程" || true

# 2. 走标准 stop（用 PID_FILE）
if [ -x "${APP_DEST}/cmd/main" ]; then
    log_msg "停止服务: ${APP_DEST}/cmd/main stop"
    "${APP_DEST}/cmd/main" stop >> "${LOG_FILE}" 2>&1 || true
fi

# 3. 安全删除 .env（API Key / Token 敏感）
ENV_FILE="${TRIM_PKGETC:-/var/apps/${TRIM_APPNAME:-claude-code-sandbox}/etc}/claude.env"
if [ -f "$ENV_FILE" ]; then
    if command -v shred >/dev/null 2>&1; then
        shred -u "$ENV_FILE" 2>/dev/null || rm -f "$ENV_FILE"
    else
        rm -f "$ENV_FILE"
    fi
    log_msg "已安全删除 .env: $ENV_FILE"
fi

# 4. 退出时由 fnOS 自动清理 target/etc/var/home 等目录
log_msg "=== uninstall_init 完成（target/etc/var/home 由 fnOS 清理）==="
exit 0
