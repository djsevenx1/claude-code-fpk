#!/bin/bash
# Claude Code 沙箱 - upgrade_init
# 升级前：停服务
#
# 关键设计（v1.2.4）：
#   - 严格按 fnOS 官方文档：生命周期脚本用 $TRIM_TEMP_LOGFILE
#   - 同时写 ${TRIM_PKGVAR}/install.log 持久化位置，用户能直接打开

LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/claude-code-sandbox-upgrade.log}"
PERSIST_LOG="${TRIM_PKGVAR:+${TRIM_PKGVAR}/install.log}"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
[ -n "$PERSIST_LOG" ] && mkdir -p "$(dirname "$PERSIST_LOG")" 2>/dev/null || true
: > "$LOG_FILE" 2>/dev/null || true

log() {
    local line="[$(date '+%H:%M:%S')] $*"
    echo "$line" >> "$LOG_FILE"
    [ -n "$PERSIST_LOG" ] && echo "$line" >> "$PERSIST_LOG"
}
die() {
    log "FATAL: $*"
    printf '%s\n' "$*" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    exit 1
}

# 升级前停止服务
APP_DEST="${TRIM_APPDEST:-/var/apps/claude-code-sandbox/target}"
if [ -x "${APP_DEST}/cmd/main" ]; then
    log "停止服务: ${APP_DEST}/cmd/main stop"
    "${APP_DEST}/cmd/main" stop >> "$LOG_FILE" 2>&1 || true
fi

log "upgrade_init 完成"
exit 0
