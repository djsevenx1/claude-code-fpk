#!/bin/bash
# Claude Code 沙箱 - uninstall_callback
# fnpack 1.2.3 build 强制要求此文件存在；卸载清理实际由 uninstall_init 完成
# （因为 fnpack 1.2.3 不支持 wizard/uninstall，所以没有 wizard_purge_data 选项）
#
# 关键设计（v1.2.3）：用 $TRIM_TEMP_LOGFILE
LOG_FILE="${TRIM_TEMP_LOGFILE:-/tmp/claude-code-sandbox-uninstall-cb.log}"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
: > "$LOG_FILE" 2>/dev/null || true
echo "[$(date '+%H:%M:%S')] uninstall_callback: noop (cleanup done in uninstall_init)" >> "$LOG_FILE"
exit 0
