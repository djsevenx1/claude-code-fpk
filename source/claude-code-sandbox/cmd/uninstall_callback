#!/bin/bash
# Claude Code 沙箱 - uninstall_callback
# fnpack 1.2.3 build 强制要求此文件存在；卸载清理实际由 uninstall_init 完成

_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/lib"
[ -f "${_LIB_DIR}/log.sh" ] && source "${_LIB_DIR}/log.sh"

log_msg "uninstall_callback: noop (cleanup done in uninstall_init)"
exit 0
