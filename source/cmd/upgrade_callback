#!/bin/bash
# 升级回调：升级 Claude Code 到最新版
export PATH="/var/apps/nodejs_v22/target/bin:${PATH}"

: "${TRIM_APPDEST:?TRIM_APPDEST 未设置}"
LOG_FILE="${TRIM_PKGVAR:-${TRIM_APPDEST}/var}/info.log"

if [ -f "${TRIM_APPDEST}/package.json" ]; then
    cd "${TRIM_APPDEST}"
    npm update @anthropic-ai/claude-code >>"${LOG_FILE}" 2>&1 || \
        npm install @anthropic-ai/claude-code >>"${LOG_FILE}" 2>&1 || true
fi
exit 0
